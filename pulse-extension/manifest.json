{
  "manifest_version": 3,
  "name": "Pulse Error Finder",
  "version": "1.0.0",
  "description": "Zoekt fouten in de Pulse-meetdatatabel: scrolt zelf door de data, stopt bij de eerste fout en markeert de rij. Alleen-lezen.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "Pulse Error Finder: toon bediening",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
